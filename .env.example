# Copy this file to .env and fill in real values. .env is gitignored and never committed.

APP_DEBUG=0

# --- MySQL — local dev: XAMPP (root / no password) seeded from the .sql dump.
#     Production: real Hostinger DB credentials, set directly in the server's own .env. ---
DB_HOST=localhost
DB_NAME=u942667021_abilisto_db
DB_USER=root
DB_PASS=

# --- Supabase Postgres — migration target ---
PG_HOST=
PG_PORT=5432
PG_NAME=postgres
PG_USER=postgres
PG_PASS=

# --- PayMongo (payments) ---
# Get these from the PayMongo Dashboard (dashboard.paymongo.com):
#   1. Developers > API Keys -> copy the Secret Key and Public Key (test keys
#      first: sk_test_.../pk_test_...; switch to sk_live_/pk_live_ once verified).
#   2. Developers > Webhooks -> Add Endpoint, URL = https://abilisto.site/client/paymongo_webhook.php,
#      events = payment.paid, payment.failed -> copy its Signing Secret.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google Gemini (client chatbot) ---
GEMINI_API_KEY=

# --- Firebase (push notifications JS SDK + Document AI) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=storage/secrets/your-service-account.json

# --- Google OAuth (login with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://abilisto.site/auth/google_callback.php

# --- OpenRouter (GreenLoop AI) ---
OPENROUTER_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- OneSignal (push notifications) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- iProgSMS (OTP) ---
IPROG_API_TOKEN=

# --- Optional / not currently wired into code ---
BREVO_API_KEY=
TIDB_HOST=
TIDB_USER=
TIDB_PASS=
TIDB_DB=
TIDB_PORT=
