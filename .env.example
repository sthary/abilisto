# Copy this file to .env and fill in real values. .env is gitignored and never committed.

APP_DEBUG=0

# --- Hostinger MySQL ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- Xendit (payments) ---
XENDIT_SECRET_KEY=

# --- Google Gemini (client chatbot) ---
GEMINI_API_KEY=

# --- Firebase (push notifications JS SDK + Document AI) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=storage/secrets/your-service-account.json

# --- Google OAuth (login with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://abilisto.site/auth/google_callback.php

# --- OpenRouter (GreenLoop AI) ---
OPENROUTER_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- OneSignal (push notifications) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- iProgSMS (OTP) ---
IPROG_API_TOKEN=

# --- Optional / not currently wired into code ---
BREVO_API_KEY=
TIDB_HOST=
TIDB_USER=
TIDB_PASS=
TIDB_DB=
TIDB_PORT=
